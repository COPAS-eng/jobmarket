# JobMarket - Environment Variables
# Copy this file to .env in each app directory and fill in your values

# ===========================================
# API Environment (apps/api/.env)
# ===========================================
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://jobmarket:devpassword@localhost:5432/jobmarket?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"
JWT_REFRESH_SECRET="your-refresh-secret-different-from-above-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
BCRYPT_ROUNDS=12

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
STRIPE_CONNECT_CLIENT_ID="ca_your_connect_client_id"
STRIPE_PRICE_PRO="price_your_pro_price_id"
STRIPE_PRICE_ENTERPRISE="price_your_enterprise_price_id"

# Frontend URL (for CORS and email links)
FRONTEND_URL="http://localhost:5173"

# Email (Resend)
EMAIL_FROM="noreply@jobmarket.com"
RESEND_API_KEY="re_your_resend_api_key"

# Redis
REDIS_URL="redis://localhost:6379"

# ===========================================
# Web Environment (apps/web/.env)
# ===========================================
VITE_API_URL="http://localhost:3001/api"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
VITE_APP_NAME="JobMarket"

# ===========================================
# Production Overrides
# ===========================================
# For production, override these in your deployment environment:
# NODE_ENV=production
# DATABASE_URL=postgresql://user:pass@host:5432/db
# JWT_SECRET=generated-with-openssl-rand-base64-32
# JWT_REFRESH_SECRET=generated-with-openssl-rand-base64-32
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CONNECT_CLIENT_ID=ca_...
# FRONTEND_URL=https://jobmarket.com
# REDIS_URL=redis://user:pass@host:6379
# POSTGRES_USER=jobmarket
# POSTGRES_PASSWORD=secure-random-password